{
  "name": "content-guard",
  "version": "5.0.0-rc.0",
  "description": "Small, dependency-free text moderation for spam, toxicity and keyboard mashing, with obfuscation-resistant normalization and a reproducible benchmark.",
  "keywords": [
    "moderation",
    "spam",
    "toxicity",
    "profanity",
    "leetspeak",
    "homoglyph",
    "unicode",
    "confusables",
    "contact-form"
  ],
  "license": "MIT",
  "author": "trevor050 (https://github.com/trevor050)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor050/content-guard.git"
  },
  "homepage": "https://github.com/trevor050/content-guard#readme",
  "bugs": "https://github.com/trevor050/content-guard/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "content-guard": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.ts",
    "demo:build": "node scripts/build-demo.ts",
    "size": "node scripts/size.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bad-words": "^4.1.5",
    "hyparquet": "^1.33.0",
    "obscenity": "^0.4.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
